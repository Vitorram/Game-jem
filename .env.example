# URL pública de conexão, sem senhas/tokens. NEXT_PUBLIC_* fica visível no navegador.
# Sem esta variável, desenvolvimento usa localhost:3001 e produção usa o Render.
NEXT_PUBLIC_COOP_WS_URL=ws://localhost:3001/coop

# Variáveis do servidor backend/server.mjs
COOP_HOST=0.0.0.0
COOP_PORT=3001
# Obrigatório com NODE_ENV=production. Separar origens exatas por vírgula, sem barra final.
# Exemplo local; em produção substitua pela origem HTTPS do frontend.
COOP_ALLOWED_ORIGINS=http://localhost:3000
COOP_MAX_CONNECTIONS=256
COOP_MAX_CONNECTIONS_PER_IP=32
COOP_MAX_ROOMS=128
